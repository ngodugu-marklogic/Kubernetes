# Copy to .env at the repository root for Docker Compose.
# Set NUA_API_KEY to enable model-backed agent prompts.
NUA_API_KEY=
NUA_API_URI=https://aws-us-east-2-1.rag.progress.cloud
DEFAULT_CHAT_MODEL=chatgpt-5.6-sol
# Optional GitHub CLI token. Use a fine-grained, read-only token scoped to required repositories.
GH_TOKEN=
# Optional host ACLI config directory mounted into the backend container.
# OAuth secrets stored in the macOS Keychain cannot be mounted; use an ACLI
# API-token profile when sharing authentication with the Linux container.
# ACLI_CONFIG_DIR=/Users/you/.config/acli
TEAMS_WEBHOOK_URL=
TEAMS_WEBHOOK_BEARER_TOKEN=
# Jira Cloud API credentials. Use an API token, not your Atlassian password.
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_BASE_URL=https://your-domain.atlassian.net
# Optional published host port (the backend listens on port 8888 in the container).
BACKEND_PORT=8888
# Base URL the frontend uses to call the backend API (defaults to http://localhost:8888).
VITE_API_BASE_URL=http://localhost:8888
# Temporary direct Jira REST access, until the Jira MCP integration lands.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
